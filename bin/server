#!/bin/bash
# FlowSpecOps Server Management Script
# Usage: bin/server [start|stop|restart|status|logs]

SESSION_NAME="flowspec-ops"
PROJECT_DIR="/Users/carroll67/Dropbox/code/work2/flowspec-ops"

start() {
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Server already running in tmux session '$SESSION_NAME'"
    echo "Use 'bin/server logs' to view, or 'bin/server restart' to restart"
    return 1
  fi

  echo "Starting FlowSpecOps server..."
  tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" "mix phx.server"
  echo "✓ Server started in tmux session '$SESSION_NAME'"
  echo "  → http://localhost:4008"
  echo "  → Use 'bin/server logs' to view output"
}

stop() {
  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Server is not running"
    return 1
  fi

  echo "Stopping FlowSpecOps server..."
  tmux send-keys -t "$SESSION_NAME" C-c
  sleep 2
  tmux kill-session -t "$SESSION_NAME" 2>/dev/null
  echo "✓ Server stopped"
}

restart() {
  echo "Restarting FlowSpecOps server..."
  stop 2>/dev/null
  sleep 1
  start
}

status() {
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "✓ Server is running in tmux session '$SESSION_NAME'"
    echo "  → http://localhost:4008"
  else
    echo "✗ Server is not running"
  fi
}

logs() {
  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Server is not running. Use 'bin/server start' first."
    return 1
  fi

  echo "Attaching to server logs (Ctrl+B, D to detach)..."
  tmux attach-session -t "$SESSION_NAME"
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    restart
    ;;
  status)
    status
    ;;
  logs)
    logs
    ;;
  *)
    echo "FlowSpecOps Server Management"
    echo ""
    echo "Usage: bin/server [command]"
    echo ""
    echo "Commands:"
    echo "  start    Start the Phoenix server in tmux"
    echo "  stop     Stop the server"
    echo "  restart  Restart the server"
    echo "  status   Check if server is running"
    echo "  logs     Attach to server output (Ctrl+B, D to detach)"
    echo ""
    ;;
esac
